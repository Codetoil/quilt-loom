+package net.fabricmc.loom.util;
+
+import java.util.List;
+
+public class Arguments {
+	public static String join(List<String> args) {
+		final var sb = new StringBuilder();
+		boolean first = true;
+
+		for (String arg : args) {
+			if (!first) {
+				sb.append(" ");
+			}
+
+			first = false;
+
+			if (arg.contains(" ")) {
+				sb.append("\"").append(arg).append("\"");
+			} else {
+				sb.append(arg);
+			}
+		}
+
+		return sb.toString();
+	}
+}
