+		try {
+			return GSON.fromJson(object, EncryptedValue.class);
+		} catch (RuntimeException e) {
+			throw new IOException("Invalid encrypted string file", e);
+		}
+	}
+
+	private static int parseVersion(JsonObject object) throws IOException {
